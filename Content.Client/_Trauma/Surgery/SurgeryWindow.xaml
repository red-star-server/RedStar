<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="using:Content.Client.UserInterface.Controls"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    Title="{Loc 'surgery-ui-window-title'}"
    MinSize="400 400">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Orientation="Horizontal">
            <Button Name="PartsButton" Text="{Loc 'surgery-ui-window-parts'}"
                    HorizontalExpand="True" StyleClasses="OpenRight" />
            <Button Name="SurgeriesButton" Text="{Loc 'surgery-ui-window-surgeries'}"
                    HorizontalExpand="True" StyleClasses="OpenLeft" />
        </BoxContainer>
        <controls:Separator Orientation="Horizontal" ColorOverride="#4972A1"/>
        <BoxContainer Name="StepStrip" Orientation="Horizontal" HorizontalAlignment="Center"
                      SeparationOverride="6" Margin="0 4" Visible="False" />
        <ScrollContainer VScrollEnabled="True" HorizontalExpand="True" VerticalExpand="True">
            <BoxContainer Name="Parts" Orientation="Vertical" SeparationOverride="2" Visible="False" />
            <BoxContainer Name="Surgeries" Orientation="Vertical" SeparationOverride="2" Visible="False" />
            <BoxContainer Name="Steps" Orientation="Vertical" SeparationOverride="2" Visible="False" />
        </ScrollContainer>
    </BoxContainer>
    <PanelContainer Name="DisabledPanel" HorizontalExpand="True" VerticalExpand="True" Visible="False">
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BackgroundColor="#000000BF" />
        </PanelContainer.PanelOverride>
        <RichTextLabel Name="DisabledLabel" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </PanelContainer>
</controls:FancyWindow>
