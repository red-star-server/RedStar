<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'point-disk-console-title'}"
                      MinSize="440 320" SetSize="440 320">
    <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="10">
        <BoxContainer Orientation="Horizontal" SeparationOverride="10">
            <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                <Label Text="{Loc 'point-disk-console-balance'}" StyleClasses="LabelSubText" />
                <Label Name="BalanceLabel" StyleClasses="LabelHeading" />
            </BoxContainer>
            <Button Name="ServerButton" Text="{Loc 'lathe-menu-server-list'}"
                    VerticalAlignment="Center" />
        </BoxContainer>
        <controls:Separator StyleClasses="LowDivider" />
        <Label Name="StatusLabel" />
        <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
            <BoxContainer Name="DiskList" Orientation="Vertical" SeparationOverride="6" />
        </ScrollContainer>
    </BoxContainer>
</controls:FancyWindow>
