<ui:XenobiologySampleAnalyzerWindow xmlns="https://spacestation14.io"
                                    xmlns:ui="clr-namespace:Content.Client._RedStar.Xenobiology.UI"
                                    Title="{Loc 'xenobiology-analyzer-title'}" MinSize="260 270" SetSize="300 300">
    <BoxContainer Orientation="Vertical" Margin="14" SeparationOverride="12">
        <PanelContainer StyleClasses="PanelDeep" HorizontalAlignment="Center" SetSize="96 96">
            <SpriteView Name="SampleView" SetSize="80 80" Margin="8" Stretch="Fill" />
        </PanelContainer>
        <ProgressBar Name="AnalysisProgress" MinValue="0" MaxValue="1" MinHeight="18" HorizontalExpand="True" />
        <Label Name="StatusLabel" StyleClasses="LabelSubText" Align="Center" HorizontalExpand="True" />
        <Button Name="AnalyzeButton" Text="{Loc 'xenobiology-analyzer-analyze-verb'}" MinHeight="36" Disabled="True" HorizontalExpand="True" />
    </BoxContainer>
</ui:XenobiologySampleAnalyzerWindow>
