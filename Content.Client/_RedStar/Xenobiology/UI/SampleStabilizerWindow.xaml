<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:xenobio="clr-namespace:Content.Client._RedStar.Xenobiology.UI"
                      Title="{Loc 'sample-stabilizer-menu-title'}"
                      MinSize="720 450">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="8">
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True">
            <BoxContainer Orientation="Vertical" MinWidth="250" HorizontalExpand="True" VerticalExpand="True">
                <PanelContainer StyleClasses="PanelDark" HorizontalExpand="True">
                    <Label StyleClasses="LabelHeading" Text="{Loc 'sample-stabilizer-menu-samples-label'}"
                           Margin="8 4" HorizontalExpand="True" Align="Center" />
                </PanelContainer>
                <PanelContainer StyleClasses="PanelInsetDeep" Margin="0 4 0 0" HorizontalExpand="True" VerticalExpand="True">
                    <Label Name="NoDishLabel" Text="{Loc 'sample-stabilizer-menu-no-dish-label'}" Align="Center" />
                    <Label Name="EmptyDishLabel" Text="{Loc 'sample-stabilizer-menu-empty-dish-label'}" Align="Center" Visible="False" />
                    <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
                        <BoxContainer Name="SampleContainer" Margin="8" Orientation="Vertical" HorizontalExpand="True" />
                    </ScrollContainer>
                </PanelContainer>
            </BoxContainer>
            <PanelContainer Margin="8 0" StyleClasses="LowDivider" />
            <BoxContainer Orientation="Vertical" MinWidth="300" HorizontalExpand="True" VerticalExpand="True">
                <PanelContainer StyleClasses="PanelDark" HorizontalExpand="True">
                    <Label StyleClasses="LabelHeading" Text="{Loc 'sample-stabilizer-menu-details-label'}"
                           Margin="8 4" HorizontalExpand="True" Align="Center" />
                </PanelContainer>
                <PanelContainer StyleClasses="PanelInsetDeep" Margin="0 4 0 0" HorizontalExpand="True" VerticalExpand="True">
                    <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
                        <BoxContainer Orientation="Vertical" Margin="10" HorizontalExpand="True">
                            <Label Name="NoSelectionLabel" Text="{Loc 'sample-stabilizer-menu-no-selection-label'}" />
                            <xenobio:SampleInfoControl Name="SampleInfoA" Visible="False" />
                            <PanelContainer Name="InfoDivider" StyleClasses="LowDivider" Margin="0 8" Visible="False" />
                            <xenobio:SampleInfoControl Name="SampleInfoB" Visible="False" />
                        </BoxContainer>
                    </ScrollContainer>
                </PanelContainer>
            </BoxContainer>
        </BoxContainer>
        <RichTextLabel Name="IncompatibleLabel" Visible="False" Margin="0 8 0 0" />
        <ProgressBar Name="StabilizationProgressBar" Visible="False" MinValue="0" MaxValue="100" Value="0"
                     Margin="0 8 0 4" HorizontalExpand="True" />
        <Button Name="StabilizationButton" Text="{Loc 'sample-stabilizer-menu-stabilization-button'}"
                HorizontalExpand="True" Margin="0 8 0 0" />
    </BoxContainer>
</controls:FancyWindow>
