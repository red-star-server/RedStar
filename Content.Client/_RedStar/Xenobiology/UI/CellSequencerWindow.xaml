<controls:FancyWindow xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:lab="clr-namespace:Content.Client._RedStar.Xenobiology.UI"
    Title="{Loc 'cell-sequencer-menu-title'}"
    MinSize="940 580">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="7" Margin="8">
        <BoxContainer Orientation="Horizontal" SeparationOverride="7" MinHeight="190">
            <PanelContainer StyleClasses="PanelInsetDeep" MinWidth="225" VerticalExpand="True">
                <BoxContainer Orientation="Vertical" SeparationOverride="5">
                    <PanelContainer StyleClasses="PanelDark" HorizontalExpand="True">
                        <Label Text="{Loc 'cell-sequencer-samples'}" StyleClasses="LabelHeading" Margin="10 5 10 5" />
                    </PanelContainer>
                    <ScrollContainer VerticalExpand="True" Margin="8 3 8 0">
                        <BoxContainer Name="SampleList" Orientation="Vertical" SeparationOverride="4" />
                    </ScrollContainer>
                    <PanelContainer StyleClasses="PanelDark" HorizontalExpand="True">
                        <Label Name="SampleDetails" Margin="10 5 10 5" />
                    </PanelContainer>
                </BoxContainer>
            </PanelContainer>
            <PanelContainer StyleClasses="PanelInsetDeep" HorizontalExpand="True" VerticalExpand="True">
                <BoxContainer Orientation="Vertical" SeparationOverride="5">
                    <PanelContainer StyleClasses="PanelDark" HorizontalExpand="True">
                        <BoxContainer Orientation="Horizontal" Margin="10 4 8 4" SeparationOverride="5">
                            <Label Text="{Loc 'cell-sequencer-map'}" StyleClasses="LabelHeading" HorizontalExpand="True" />
                            <Button Name="CompareButton" Text="{Loc 'cell-sequencer-compare'}" />
                        </BoxContainer>
                    </PanelContainer>
                    <lab:SequencerGenomeControl Name="Genome" Margin="8 2 8 0" />
                    <PanelContainer StyleClasses="PanelDark" Margin="8 0 8 5">
                        <BoxContainer Orientation="Horizontal" Margin="8 4 8 4" SeparationOverride="8">
                            <Label Name="MarkerDetails" HorizontalExpand="True" />
                            <Label Name="ComparisonLabel" />
                        </BoxContainer>
                    </PanelContainer>
                </BoxContainer>
            </PanelContainer>
        </BoxContainer>
        <PanelContainer StyleClasses="PanelInsetDeep" HorizontalExpand="True" VerticalExpand="True">
            <BoxContainer Orientation="Vertical" SeparationOverride="5">
                <PanelContainer StyleClasses="PanelDark" HorizontalExpand="True">
                    <BoxContainer Orientation="Horizontal" Margin="10 5 10 5">
                        <Label Text="{Loc 'cell-sequencer-assembly'}" StyleClasses="LabelHeading" HorizontalExpand="True" />
                        <Label Name="DecodeStatus" />
                    </BoxContainer>
                </PanelContainer>
                <lab:SequencerAssemblyControl Name="Assembly" Margin="8 4 8 0" HorizontalExpand="True" VerticalExpand="True" />
                <PanelContainer StyleClasses="PanelDark" HorizontalExpand="True">
                    <BoxContainer Orientation="Horizontal" Margin="10 5 10 5" SeparationOverride="8">
                        <Label Name="ResultLabel" HorizontalExpand="True" />
                        <Button Name="ResetButton" Text="{Loc 'cell-sequencer-reset'}" />
                        <Button Name="DecodeButton" Text="{Loc 'cell-sequencer-submit'}" />
                    </BoxContainer>
                </PanelContainer>
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
</controls:FancyWindow>
