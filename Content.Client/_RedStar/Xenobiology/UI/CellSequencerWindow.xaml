<controls:FancyWindow xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="{Loc 'cell-sequencer-menu-title'}"
    MinSize="900 540">
    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="8" Margin="8">
        <PanelContainer StyleClasses="PanelInsetDeep" MinWidth="210" VerticalExpand="True">
            <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6">
                <Label Text="{Loc 'cell-sequencer-primary-sample'}" StyleClasses="LabelHeading" />
                <ScrollContainer VerticalExpand="True">
                    <BoxContainer Name="SampleList" Orientation="Vertical" SeparationOverride="3" />
                </ScrollContainer>
                <Label Name="SampleDetails" />
                <Label Text="{Loc 'cell-sequencer-comparison-sample'}" StyleClasses="LabelHeading" />
                <ScrollContainer VerticalExpand="True">
                    <BoxContainer Name="ComparisonSampleList" Orientation="Vertical" SeparationOverride="3" />
                </ScrollContainer>
            </BoxContainer>
        </PanelContainer>
        <PanelContainer StyleClasses="PanelInsetDeep" MinWidth="315" HorizontalExpand="True" VerticalExpand="True">
            <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6">
                <Label Text="{Loc 'cell-sequencer-map'}" StyleClasses="LabelHeading" />
                <Label Text="{Loc 'cell-sequencer-map-help'}" />
                <Label Name="PrimaryLabel" />
                <ScrollContainer VerticalExpand="True">
                    <BoxContainer Name="PrimaryMarkerList" Orientation="Vertical" SeparationOverride="3" />
                </ScrollContainer>
                <Label Name="ComparisonLabel" />
                <ScrollContainer VerticalExpand="True">
                    <BoxContainer Name="ComparisonMarkerList" Orientation="Vertical" SeparationOverride="3" />
                </ScrollContainer>
            </BoxContainer>
        </PanelContainer>
        <PanelContainer StyleClasses="PanelInsetDeep" MinWidth="300" VerticalExpand="True">
            <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="8">
                <Label Text="{Loc 'cell-sequencer-decoding'}" StyleClasses="LabelHeading" />
                <Label Name="MarkerDetails" />
                <Label Text="{Loc 'cell-sequencer-fragment-help'}" />
                <ScrollContainer VerticalExpand="True">
                    <BoxContainer Name="FragmentList" Orientation="Vertical" SeparationOverride="4" />
                </ScrollContainer>
                <Label Name="AssemblyLabel" />
                <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                    <Button Name="ResetButton" Text="{Loc 'cell-sequencer-reset'}" HorizontalExpand="True" />
                    <Button Name="DecodeButton" Text="{Loc 'cell-sequencer-submit'}" HorizontalExpand="True" />
                </BoxContainer>
                <Label Name="ResultLabel" />
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
</controls:FancyWindow>
