<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'medical-records-console-title'}"
                      MinSize="760 520">
    <BoxContainer Orientation="Horizontal" Margin="8">
        <BoxContainer Orientation="Vertical" MinWidth="245" MaxWidth="245">
            <Label Text="{Loc 'medical-records-console-list-title'}" StyleClasses="LabelHeading" />
            <LineEdit Name="SearchEdit" PlaceHolder="{Loc 'rs-med-records-search'}" />
            <ScrollContainer VerticalExpand="True">
                <ItemList Name="RecordListing" />
            </ScrollContainer>
        </BoxContainer>
        <ScrollContainer HorizontalExpand="True" VerticalExpand="True" Margin="12 0 0 0">
            <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                <BoxContainer Name="TriagePanel" Orientation="Vertical">
                    <Label Text="{Loc 'rs-med-triage-heading'}" StyleClasses="LabelHeading" />
                    <Label Name="PriorityLabel" />
                    <Label Name="DoctorLabel" />
                    <BoxContainer Name="TriageButtons" Orientation="Horizontal" />
                    <Button Name="ClaimButton" Text="{Loc 'rs-med-triage-claim'}" />
                    <PanelContainer StyleClasses="LowDivider" />
                </BoxContainer>
                <BoxContainer Name="RecordDetails" Orientation="Vertical" HorizontalExpand="True" />
            </BoxContainer>
        </ScrollContainer>
    </BoxContainer>
</controls:FancyWindow>
