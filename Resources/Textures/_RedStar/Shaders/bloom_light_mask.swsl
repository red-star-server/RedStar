blend_mode multiply;

uniform highp vec2 MaskSize;
uniform sampler2D SCREEN_TEXTURE;
uniform highp float Saturation;
uniform highp float HazeAmount;

highp vec3 maskSample(highp vec2 offset, highp vec2 uvDx, highp vec2 uvDy, highp vec2 screenPixel) {
    // RSI frames may share an atlas. Keep the filter within this frame.
    highp vec2 pixel = TEXTURE_PIXEL_SIZE;
    highp vec2 start = UV - UV2 * MaskSize * pixel;
    // Both samples refer to the same screen position, including rotated fixtures and camera zoom.
    highp vec2 uv = UV + uvDx * offset.x + uvDy * offset.y;
    highp vec4 texel = zTexture(clamp(uv, start + pixel * 0.5, start + (MaskSize - 0.5) * pixel));
    highp vec2 screenUV = clamp((screenPixel + offset) * SCREEN_PIXEL_SIZE,
        SCREEN_PIXEL_SIZE * 0.5, vec2(1.0) - SCREEN_PIXEL_SIZE * 0.5);
    highp vec3 background = zTextureSpec(SCREEN_TEXTURE, screenUV).rgb;
    highp float luminance = dot(background, vec3(0.2126, 0.7152, 0.0722));
    highp float response = mix(1.0, 2.0, smoothstep(0.02, 0.55, luminance));
    return texel.rgb * texel.a * response;
}

void fragment() {
    highp vec2 uvDx = dFdx(UV);
    highp vec2 uvDy = dFdy(UV);
    highp vec3 mask = maskSample(vec2(0.0), uvDx, uvDy, FRAGCOORD.xy) * 0.2;
    mask += maskSample(vec2(1.0, 0.0), uvDx, uvDy, FRAGCOORD.xy) * 0.0625;
    mask += maskSample(vec2(-1.0, 0.0), uvDx, uvDy, FRAGCOORD.xy) * 0.0625;
    mask += maskSample(vec2(0.0, 1.0), uvDx, uvDy, FRAGCOORD.xy) * 0.0625;
    mask += maskSample(vec2(0.0, -1.0), uvDx, uvDy, FRAGCOORD.xy) * 0.0625;
    mask += maskSample(vec2(1.0, 1.0), uvDx, uvDy, FRAGCOORD.xy) * 0.0625;
    mask += maskSample(vec2(-1.0, 1.0), uvDx, uvDy, FRAGCOORD.xy) * 0.0625;
    mask += maskSample(vec2(1.0, -1.0), uvDx, uvDy, FRAGCOORD.xy) * 0.0625;
    mask += maskSample(vec2(-1.0, -1.0), uvDx, uvDy, FRAGCOORD.xy) * 0.0625;
    mask += maskSample(vec2(2.0, 0.0), uvDx, uvDy, FRAGCOORD.xy) * 0.0375;
    mask += maskSample(vec2(-2.0, 0.0), uvDx, uvDy, FRAGCOORD.xy) * 0.0375;
    mask += maskSample(vec2(0.0, 2.0), uvDx, uvDy, FRAGCOORD.xy) * 0.0375;
    mask += maskSample(vec2(0.0, -2.0), uvDx, uvDy, FRAGCOORD.xy) * 0.0375;
    mask += maskSample(vec2(2.0, 2.0), uvDx, uvDy, FRAGCOORD.xy) * 0.0375;
    mask += maskSample(vec2(-2.0, 2.0), uvDx, uvDy, FRAGCOORD.xy) * 0.0375;
    mask += maskSample(vec2(2.0, -2.0), uvDx, uvDy, FRAGCOORD.xy) * 0.0375;
    mask += maskSample(vec2(-2.0, -2.0), uvDx, uvDy, FRAGCOORD.xy) * 0.0375;

    // Use illumination for visibility, not a second tint of the lamp's RGB.
    highp float illumination = max(max(lightSample.r, lightSample.g), lightSample.b);
    highp float visibility = smoothstep(0.02, 0.2, illumination);
    highp float sourceLuminance = dot(MODULATE.rgb, vec3(0.2126, 0.7152, 0.0722));
    highp vec3 sourceColor = max(mix(vec3(sourceLuminance), MODULATE.rgb, max(Saturation, 0.0)), vec3(0.0));
    sourceColor /= max(1.0, max(max(sourceColor.r, sourceColor.g), sourceColor.b));
    highp float sourcePeak = max(max(sourceColor.r, sourceColor.g), sourceColor.b);
    // Neutral scattering derives its brightness from the lamp, without a fixed warm tint.
    highp vec3 hazeColor = mix(sourceColor, vec3(sourcePeak), clamp(HazeAmount, 0.0, 1.0));
    highp vec3 glow = mask * hazeColor * MODULATE.a * visibility;

    // T = product(1 - glow): bounded, order-independent accumulation over a white buffer.
    COLOR = vec4(vec3(1.0) - clamp(glow, 0.0, 1.0), 1.0);
    MODULATE = vec4(1.0);
    lightSample = vec3(1.0);
}
