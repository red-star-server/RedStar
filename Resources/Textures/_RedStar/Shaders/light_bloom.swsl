uniform sampler2D SCREEN_TEXTURE;

void fragment() {
    lowp vec4 mask = zTexture(UV);
    if (mask.a <= 0.001)
        discard;

    lowp float light_level = max(max(lightSample.r, lightSample.g), lightSample.b);
    lowp float light_visibility = smoothstep(0.12, 0.85, light_level);
    highp vec2 screen_uv = FRAGCOORD.xy * SCREEN_PIXEL_SIZE;
    lowp vec3 background = zTextureSpec(SCREEN_TEXTURE, screen_uv).rgb;
    lowp float luminance = dot(background, vec3(0.2126, 0.7152, 0.0722));
    lowp float surface_visibility = mix(0.22, 1.0, smoothstep(0.015, 0.22, luminance));
    lowp float alpha = mask.a * 0.30 * light_visibility * surface_visibility;
    lowp vec3 warmth = vec3(1.0, 0.91, 0.76);

    COLOR = vec4(mix(mask.rgb, warmth, 0.16), alpha);
}
