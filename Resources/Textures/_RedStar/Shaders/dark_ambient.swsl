light_mode unshaded;
blend_mode none;

uniform sampler2D SCREEN_TEXTURE;
uniform highp float Intensity;
uniform highp float ShadowDepth;
uniform highp float Warmth;

void fragment() {
    highp vec4 source = zTextureSpec(SCREEN_TEXTURE, Pos);
    highp float luminance = dot(source.rgb, vec3(0.2126, 0.7152, 0.0722));
    highp float brightest = max(source.r, max(source.g, source.b));
    highp float darkest = min(source.r, min(source.g, source.b));
    highp float saturation = (brightest - darkest) / max(brightest, 0.0001);

    // Preserve bright colored signals while deepening the lower tones.
    highp float signal = smoothstep(0.7, 1.0, saturation) * smoothstep(0.35, 0.85, brightest);
    highp float gain = pow(max(luminance, 0.0001), max(ShadowDepth, 0.0) * (1.0 - 0.8 * signal));
    highp float highlightProtection = smoothstep(0.55, 0.95, luminance);
    gain = mix(min(gain, 1.0), 1.0, highlightProtection);

    // Warm neutral shadows and midtones; retain the hue of saturated light.
    highp float shadow = 1.0 - smoothstep(0.02, 0.7, luminance);
    highp float tintWeight = shadow * (1.0 - saturation) * clamp(Warmth, 0.0, 1.0);
    highp vec3 tint = mix(vec3(1.0), vec3(1.0, 0.90, 0.78), tintWeight);
    highp vec3 graded = source.rgb * gain * tint;

    // No additive light: black, transparency, and bright endpoints are preserved.
    COLOR = vec4(mix(source.rgb, graded, clamp(Intensity, 0.0, 1.0)), source.a);
}
