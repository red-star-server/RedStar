stack-honeycomb = { $amount ->
    [1] сота
    [few] соты
    *[other] сот
}
stack-beeswax = { $amount ->
    [1] кусок
    [few] куска
    *[other] кусков
} воска

reagent-name-honey = мёд
reagent-desc-honey = Сладкий и тягучий мёд из улья.

reagent-name-royal-jelly = маточное молочко
reagent-desc-royal-jelly = Густое белое молочко из яйца пчелиной матки. Немного лечит отравления, а в матке даёт место для ещё одного признака.
reagent-name-liquid-beeswax = жидкий воск
reagent-desc-liquid-beeswax = Растопленный воск свечей. Если нагреть выше 340 K, застывает в кусок воска.
